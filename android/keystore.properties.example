# 复制成 keystore.properties 并填入你自己的口令（keystore.properties 已被 .gitignore 忽略）
# 密钥库生成命令（在 android/ 目录下执行）：
#   keytool -genkeypair -v -keystore keystore/cinemavault-release.jks \
#     -alias cinemavault -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=CinemaVault, O=CinemaVault, OU=Mobile, C=CN"
storeFile=../keystore/cinemavault-release.jks
storePassword=CHANGE_ME
keyAlias=cinemavault
keyPassword=CHANGE_ME
